<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Form sản phẩm</title></head><body style="font-family:Arial;max-width:1000px;margin:30px auto"><h2>${empty sp ? 'Thêm sản phẩm':'Sửa sản phẩm'}</h2><p style="color:red">${error}</p>
<form method="post" action="${pageContext.request.contextPath}/san-pham"><input type="hidden" name="id" value="${sp.id}"><p>Mã: <input name="ma" value="${sp.ma}" required></p><p>Tên: <input name="ten" value="${sp.ten}" required></p><p>Mô tả: <input name="moTa" value="${sp.moTa}"></p><p>Giá: <input type="number" step="0.01" name="gia" value="${sp.gia}" required></p><p>Số lượng: <input type="number" name="soLuong" value="${sp.soLuong}" required></p><button>Lưu</button></form><a href="${pageContext.request.contextPath}/san-pham">Quay lại</a></body></html>
