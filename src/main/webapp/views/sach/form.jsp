<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Form sách</title></head><body style="font-family:Arial;max-width:1000px;margin:30px auto"><h2>${empty sach ? 'Thêm sách':'Sửa sách'}</h2>
<form method="post" action="${pageContext.request.contextPath}/sach"><input type="hidden" name="id" value="${sach.id}"><p>Mã: <input name="maSach" value="${sach.maSach}" required></p><p>Tên: <input name="tenSach" value="${sach.tenSach}" required></p><p>Tác giả: <input name="tacGia" value="${sach.tacGia}" required></p><p>NXB: <input name="nhaXuatBan" value="${sach.nhaXuatBan}"></p><p>Năm: <input type="number" name="namXuatBan" value="${sach.namXuatBan}"></p><button>Lưu</button></form><a href="${pageContext.request.contextPath}/sach">Quay lại</a></body></html>
