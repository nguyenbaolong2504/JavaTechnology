<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Lớp học</title></head><body style="font-family:Arial;max-width:1000px;margin:30px auto"><h2>Quản lý lớp học</h2><form method="get"><input name="keyword" value="${keyword}" placeholder="Mã hoặc tên lớp"><button>Tìm</button></form><p><a href="${pageContext.request.contextPath}/lop-hoc?action=new">+ Thêm lớp</a></p>
<table border="1" cellpadding="6" cellspacing="0" width="100%"><tr><th>ID</th><th>Mã</th><th>Tên</th><th>Cố vấn</th><th>Số SV</th><th>Thao tác</th></tr><c:forEach var="x" items="${dsLop}"><tr><td>${x.id}</td><td>${x.maLop}</td><td>${x.tenLop}</td><td>${x.coVanHocTap}</td><td>${x.soLuongSinhVien}</td><td><a href="${pageContext.request.contextPath}/lop-hoc?action=edit&id=${x.id}">Sửa</a> | <a href="${pageContext.request.contextPath}/lop-hoc?action=delete&id=${x.id}" onclick="return confirm('Xóa?')">Xóa</a></td></tr></c:forEach></table><p><a href="${pageContext.request.contextPath}/">Trang chủ</a></p></body></html>
