<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Form lớp</title></head><body style="font-family:Arial;max-width:1000px;margin:30px auto"><h2>${empty lop ? 'Thêm lớp':'Sửa lớp'}</h2><form method="post" action="${pageContext.request.contextPath}/lop-hoc"><input type="hidden" name="id" value="${lop.id}"><p>Mã: <input name="maLop" value="${lop.maLop}" required></p><p>Tên: <input name="tenLop" value="${lop.tenLop}" required></p><p>Cố vấn: <input name="coVanHocTap" value="${lop.coVanHocTap}"></p><p>Số SV: <input type="number" min="0" name="soLuongSinhVien" value="${lop.soLuongSinhVien}" required></p><button>Lưu</button></form><a href="${pageContext.request.contextPath}/lop-hoc">Quay lại</a></body></html>
