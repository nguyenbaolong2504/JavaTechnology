<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Form điểm</title></head><body style="font-family:Arial;max-width:1000px;margin:30px auto"><h2>${empty diem ? 'Nhập điểm':'Sửa điểm'}</h2><p style="color:red">${error}</p><form method="post" action="${pageContext.request.contextPath}/diem"><input type="hidden" name="id" value="${diem.id}"><p>Mã SV: <input name="maSinhVien" value="${diem.maSinhVien}" required></p><p>Họ tên: <input name="hoTen" value="${diem.hoTen}" required></p><p>Chuyên cần: <input type="number" step="0.1" min="0" max="10" name="chuyenCan" value="${diem.chuyenCan}" required></p><p>Giữa kỳ: <input type="number" step="0.1" min="0" max="10" name="giuaKy" value="${diem.giuaKy}" required></p><p>Cuối kỳ: <input type="number" step="0.1" min="0" max="10" name="cuoiKy" value="${diem.cuoiKy}" required></p><button>Lưu</button></form><a href="${pageContext.request.contextPath}/diem">Quay lại</a></body></html>
