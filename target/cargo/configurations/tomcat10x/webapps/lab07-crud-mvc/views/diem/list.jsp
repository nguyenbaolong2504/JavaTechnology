<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Điểm</title></head><body style="font-family:Arial;max-width:1000px;margin:30px auto"><h2>Quản lý điểm sinh viên</h2><p>Tổng kết = 10% CC + 30% GK + 60% CK.</p><p><a href="${pageContext.request.contextPath}/diem?action=new">+ Nhập điểm</a></p>
<table border="1" cellpadding="6" cellspacing="0" width="100%"><tr><th>Mã</th><th>Họ tên</th><th>CC</th><th>GK</th><th>CK</th><th>Tổng kết</th><th>Xếp loại</th><th>Thao tác</th></tr>
<c:forEach var="d" items="${dsDiem}"><tr><td>${d.maSinhVien}</td><td>${d.hoTen}</td><td>${d.chuyenCan}</td><td>${d.giuaKy}</td><td>${d.cuoiKy}</td><td>${d.tongKet}</td><td><b>${d.xepLoai}</b></td><td><a href="${pageContext.request.contextPath}/diem?action=edit&id=${d.id}">Sửa</a> | <a href="${pageContext.request.contextPath}/diem?action=delete&id=${d.id}">Xóa</a></td></tr></c:forEach></table><p><a href="${pageContext.request.contextPath}/">Trang chủ</a></p></body></html>
