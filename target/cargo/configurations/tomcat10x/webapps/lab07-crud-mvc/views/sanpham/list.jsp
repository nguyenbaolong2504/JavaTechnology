<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Sản phẩm</title></head><body style="font-family:Arial;max-width:1000px;margin:30px auto"><h2>Quản lý sản phẩm</h2>
<form method="get"><input name="keyword" value="${keyword}" placeholder="Mã hoặc tên"><button>Tìm</button></form><p><a href="${pageContext.request.contextPath}/san-pham?action=new">+ Thêm sản phẩm</a></p>
<table border="1" cellpadding="6" cellspacing="0" width="100%"><tr><th>ID</th><th>Mã</th><th>Tên</th><th>Mô tả</th><th>Giá</th><th>SL</th><th>Thao tác</th></tr>
<c:forEach var="sp" items="${dsSanPham}"><tr><td>${sp.id}</td><td>${sp.ma}</td><td><a href="${pageContext.request.contextPath}/san-pham?action=detail&id=${sp.id}">${sp.ten}</a></td><td>${sp.moTa}</td><td>${sp.gia}</td><td>${sp.soLuong}</td><td><a href="${pageContext.request.contextPath}/san-pham?action=edit&id=${sp.id}">Sửa</a> | <a href="${pageContext.request.contextPath}/san-pham?action=delete&id=${sp.id}" onclick="return confirm('Xóa?')">Xóa</a></td></tr></c:forEach></table><p><a href="${pageContext.request.contextPath}/">Trang chủ</a></p></body></html>
