<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Giỏ hàng</title></head><body style="font-family:Arial;max-width:1000px;margin:30px auto"><h2>Giỏ hàng bằng Session</h2><h3>Sản phẩm</h3><ul><c:forEach var="sp" items="${dsSanPham}"><li>${sp.ten} - ${sp.gia} VNĐ <a href="${pageContext.request.contextPath}/gio-hang?action=add&id=${sp.id}">Thêm</a></li></c:forEach></ul>
<h3>Giỏ hàng</h3><table border="1" cellpadding="6" cellspacing="0" width="100%"><tr><th>Mã</th><th>Tên</th><th>Giá</th><th>SL</th><th>Thành tiền</th><th></th></tr><c:forEach var="it" items="${cartItems}"><tr><td>${it.sanPham.ma}</td><td>${it.sanPham.ten}</td><td>${it.sanPham.gia}</td><td><form method="post" style="display:inline"><input type="hidden" name="id" value="${it.sanPham.id}"><input type="number" min="0" name="soLuong" value="${it.soLuong}" style="width:60px"><button>Cập nhật</button></form></td><td>${it.thanhTien}</td><td><a href="${pageContext.request.contextPath}/gio-hang?action=remove&id=${it.sanPham.id}">Xóa</a></td></tr></c:forEach></table><h3>Tổng tiền: ${tongTien} VNĐ</h3><a href="${pageContext.request.contextPath}/">Trang chủ</a></body></html>
